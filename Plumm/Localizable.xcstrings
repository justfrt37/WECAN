    "Choose how many notifications you want from each bot per day. This doesn't affect other app settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie viele Benachrichtigungen du pro Tag von jedem Bot bekommen möchtest. Das wirkt sich nicht auf andere App-Einstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuántas notificaciones quieres recibir de cada bot al día. Esto no afecta a otros ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis combien de notifications tu veux recevoir de chaque bot par jour. Cela n'affecte pas les autres réglages de l'appli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quante notifiche vuoi ricevere ogni giorno da ciascun bot. Questo non influisce sulle altre impostazioni dell'app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quantas notificações você quer receber de cada bot por dia. Isso não afeta outras configurações do app."
          }
        },
        "tr" : {
          "stringUnit" : {
